# EnPro PO Agent — Environment Variables
# Copy this file to .env and fill in the values for your environment.

# === APP ===
APP_NAME="Ariba/Coupa PO Automation Agent"
APP_VERSION=1.1.0
ENVIRONMENT=development
DEBUG=false
PORT=8000

# === SECURITY (REQUIRED IN PRODUCTION) ===
APP_API_KEY=
ADMIN_PASSPHRASE=

# === MICROSOFT GRAPH API (email intake) ===
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=orders@enproinc.com
GRAPH_POLL_INTERVAL=60

# Alias credentials used by some modules
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# === AZURE DOCUMENT INTELLIGENCE (PDF parsing) ===
DOC_INTEL_ENDPOINT=
DOC_INTEL_KEY=

# === AZURE BLOB STORAGE (crosswalk backup) ===
BLOB_CONNECTION_STRING=
BLOB_CONTAINER=ariba-coupa

# === AZURE OPENAI (optional, for AI-assisted mapping) ===
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_MODEL=gpt-4.1

# === DYNAMICS 365 CRM (optional) ===
DYNAMICS_ORG_URL=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_TENANT_ID=

# === P21 SQL (direct ODBC reads) ===
P21_SQL_SERVER=
P21_SQL_DATABASE=P21
P21_SQL_DRIVER="{ODBC Driver 17 for SQL Server}"
P21_SQL_UID=
P21_SQL_PWD=
P21_COMPANY_NO=1
P21_LOCATION_ID=10

# === P21 TRANSACTION API (live SO submission) ===
P21_BASE_URL=
P21_API_USERNAME=POAGENT
P21_API_PASSWORD=
P21_VERIFY_SSL=false
P21_DEFAULT_TAKER=POAGENT
P21_DEFAULT_COMPANY_ID=1
P21_DEFAULT_LOCATION_ID=10
P21_AUTO_SUBMIT_ON_APPROVE=false

# === INVOICE MODULE (currently disabled) ===
INVOICE_MODULE_ENABLED=false
COUPA_INVOICE_ENDPOINT=
COUPA_INVOICE_API_KEY=

# === LOCAL STORAGE PATHS ===
CROSSWALK_DIR=./data/crosswalks
CISM_OUTPUT_DIR=./data/cism_output
CISM_SO_OUTPUT_DIR=./data/cism_so_output
CISM_BATCH_DIR=./data/cism_batch
PO_STORE_DIR=./data/po_store
